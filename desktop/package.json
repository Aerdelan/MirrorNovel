{
  "name": "mirrornovel-desktop",
  "version": "1.0.2",
  "private": true,
  "description": "MirrorNovel 桌面端（Electron 外壳 + 复用 client 渲染层）",
  "author": "MirrorNovel",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env MN_DEV_SERVER=http://127.0.0.1:5174 electron .",
    "electron:prod": "electron .",
    "dist": "node scripts/build-win.mjs"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.2",
    "cross-env": "^7.0.3",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "resedit": "^1.7.2",
    "vite": "^5.0.10"
  },
  "build": {
    "appId": "top.blockstory.mirrornovel",
    "productName": "MirrorNovel",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MirrorNovel"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
