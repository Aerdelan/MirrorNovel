# MongoDB 数据库地址
MONGODB_URI=mongodb://localhost:27017/mirrornovel

# JWT 密钥（任意随机字符串）
JWT_SECRET=xiaoshuo_jwt_secret_key_2024_dev

# Token 过期时间
JWT_EXPIRES_IN=7d

# 管理员账号（启动时自动创建）
ADMIN_EMAIL=admin@xiaoshuo.com
ADMIN_PASSWORD=admin888
ADMIN_NICKNAME=超级管理员

# 端口（可选，默认 3001）
# PORT=3001

# 邮箱配置（用于发送验证码，可选）
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=465
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_email_password
# EMAIL_FROM=MirrorNovel <noreply@example.com>

EMAIL_SERVICE= 
EMAIL_HOST= 
EMAIL_PORT= 
EMAIL_USERNAME=  
EMAIL_PASSWORD= 
EMAIL_SECURE=true
PORT= 

# ===== 联网取材（Web Research，可选）=====
# provider: tavily | serper | brave | none（none = 关闭自动检索，但仍会抓取用户粘贴的链接）
# 服务器在海外时推荐 tavily（搜索+抽取一体、LLM 友好、有免费额度）
# WEB_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
# SERPER_API_KEY=
# BRAVE_API_KEY=
# 成本/规模上限（不填走默认值）
# WEB_SEARCH_MAX_QUERIES=4
# WEB_SEARCH_MAX_AUTO_URLS=3
# WEB_SEARCH_MAX_USER_URLS=6
# WEB_SEARCH_PER_PAGE_CHARS=4000
# WEB_SEARCH_BLOCK_TOKEN_CAP=2500
# WEB_SEARCH_CACHE_TTL_MS=21600000
# WEB_SEARCH_STEP_TIMEOUT_MS=45000
